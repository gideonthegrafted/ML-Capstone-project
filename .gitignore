notebooks/_dev/
results/**/*_dev.*

# ---- Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
env/

# ---- Credentials (never commit)
kaggle.json
.env
*.pem

# ---- OS / editor
.DS_Store
Thumbs.db
desktop.ini
